rules_version = '2';

/* =====================================================================
   배프 Firestore 보안 규칙

   붙여넣는 법
   1. https://console.firebase.google.com → 배프 프로젝트
   2. 왼쪽 메뉴 Firestore Database → 위쪽 "규칙" 탭
   3. 안에 있던 내용을 전부 지우고, 이 파일 내용을 통째로 붙여넣기
   4. "게시" 누르기 (1분쯤 뒤부터 적용돼요)

   로그인 방식
   - 카카오·네이버로 로그인하면: uid 가 "kakao:12345" / "naver:abcd" 모양이에요 (서버가 만든 커스텀 토큰)
   - 예전 아이디/비밀번호(데모) 계정은: 앱이 켜질 때 "익명 로그인"을 해서 request.auth 가 생겨요
   → 그래서 아래 규칙은 "어떤 방식으로든 Firebase 에 로그인돼 있어야" 읽고 쓸 수 있어요.
     (Firebase 콘솔 → Authentication → 로그인 방법 → "익명" 을 꼭 켜 주세요!)

   앱이 쓰는 컬렉션 (index.html 기준)
   - baep_accounts/<아이디>   : 예전 아이디/비밀번호 계정 + 진행 상태. 로그인할 때 읽고, 관리자 승인 목록에서
                                where('role','==','mentor').where('approved','==',...) 로 검색해요.
   - baep_requests/<요청번호> : 수업 요청. 배움님이 만들고(set) 프렌드가 수락(update),
                                where('to','==',프렌드아이디) 로 실시간 구독(onSnapshot)해요.
   - baep_users/<uid>         : (새로 추가) 간편로그인 프로필 — 역할, 이름, 전화, 연결된 예전 아이디
   ===================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    // 카카오·네이버 로그인이든 익명 로그인이든, 로그인만 돼 있으면 true
    function signedIn() {
      return request.auth != null;
    }

    // 문서 하나가 너무 커지지 않게 (Firestore 한도는 1MB, 여기선 넉넉히 필드 200개까지)
    function sane() {
      return request.resource.data.size() <= 200;
    }

    /* ---------- 간편로그인 프로필: 본인만 ----------
       baep_users/<uid> 는 그 uid 로 로그인한 사람만 읽고/쓰고/지울 수 있어요.
       (탈퇴할 때 앱이 직접 이 문서를 지워요) */
    match /baep_users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && sane();
    }

    /* ---------- 예전 아이디/비밀번호 계정 ----------
       지금 앱은 "아이디로 남의 계정 문서를 찾아서" 로그인하고, 관리자 화면에서 프렌드 지원서를 승인해요.
       그래서 로그인한 사람이면 누구나 읽기/쓰기가 돼요 (시연용 프로토타입 수준).
       나중에 꼭 조이기:
       - 비밀번호 해시(pw)가 담겨 있어서 아무나 읽을 수 있으면 안 좋아요 → 로그인은 간편로그인으로 옮기고,
         문서 주인 uid 를 필드(ownerUid)로 저장해서 "request.auth.uid == resource.data.ownerUid" 일 때만 쓰기 허용
       - approved(승인) 필드는 관리자만 바꾸게 (관리자 uid 목록이나 커스텀 클레임 role=='admin' 으로) */
    match /baep_accounts/{accountId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && accountId.size() <= 64 && sane();
      allow delete: if signedIn();
    }

    /* ---------- 수업 요청 ----------
       배움님이 요청을 만들고, 프렌드가 수락/거절하고, 결제되면 상태가 바뀌어요. 둘 다 같은 문서를 고쳐요.
       나중에 꼭 조이기:
       - 요청을 만들 때 보낸 사람 uid(fromUid)와 받는 프렌드 uid(toUid)를 저장하고,
         "그 두 사람만 읽기/고치기" 로 바꾸기
       - st(상태)를 'paid' 로 바꾸는 건 결제 서버만 하도록 (지금은 앱이 직접 바꿔요) */
    match /baep_requests/{requestId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && requestId.size() <= 128 && sane();
      allow delete: if signedIn();
    }

    /* ---------- 새 컬렉션을 추가할 때 ----------
       아래 "나머지 전부 금지" 때문에, 새 컬렉션(예: 나들이 baep_outings)을 쓰려면 여기에 블록을 꼭 추가해야 해요.
       예)
       match /baep_outings/{id} {
         allow read, write: if signedIn();
       }
    */

    /* ---------- 나머지 전부 금지 ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
